# outsmart CLI configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ─── Required ───────────────────────────────────────────────
PRIVATE_KEY=your_base58_private_key_here
MAINNET_ENDPOINT=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# ─── TX Landing Providers (optional — set any key to enable) ─
# HELIUS_API_KEY=
# JITO_API_KEY=
# BLOXROUTE_AUTH_HEADER=
# NOZOMI_API_KEY=
# BLOCKRAZOR_API_KEY=
# NEXTBLOCK_API_KEY=
# ZERO_SLOT_API_KEY=
# SOYAS_API_KEY=
# ASTRALANE_API_KEY=
# STELLIUM_API_KEY=
# FLASHBLOCK_API_KEY=
# NODE1_API_KEY=

# ─── Trading Defaults (optional) ────────────────────────────
# TX_LANDING_MODE=concurrent        # concurrent|race|random|sequential
# DEFAULT_TIP_SOL=0.001
# DEFAULT_SLIPPAGE_BPS=300          # 3%
# DEFAULT_PRIORITY_FEE=4000         # microLamports per CU

# ─── Legacy / Advanced ──────────────────────────────────────
# WS_MAINNET_ENDPOINT=wss://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
# JITO_FEE=0.0001
# BLOXROUTE_FEE=0.001
# GRPC_URL=
# GRPC_XTOKEN=
